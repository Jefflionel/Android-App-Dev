<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Grade Calculator"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/blue_primary"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/blue_primary"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload an Excel (.xlsx) file containing student names and marks.\n\nRequired columns:\n  Column A: Name\n  Column B: Mark (0 to 100)"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnSelectFile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Select Excel File"
        android:textSize="15sp"
        android:backgroundTint="@color/green_primary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No file selected"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/bg_file_name"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnProcessFile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Calculate Grades"
        android:textSize="15sp"
        android:backgroundTint="@color/blue_primary"
        android:textColor="@color/white"
        android:enabled="false" />

</LinearLayout>